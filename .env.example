# Copy this file to .env and fill in your values.
# The .env file is in .gitignore and will never be committed.

# ---------------------------------------------------------------
# Required: OpenSubtitles API key
# Get a free key at https://www.opensubtitles.com/en/consumers
# ---------------------------------------------------------------
OPENSUBTITLES_API_KEY=

# ---------------------------------------------------------------
# Optional: TMDB API key
# If blank, the free TVmaze API is used for episode metadata.
# ---------------------------------------------------------------
TMDB_API_KEY=

# ---------------------------------------------------------------
# Whisper settings (used only when hash lookup fails)
# ---------------------------------------------------------------
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cuda
